		"commands": [
			{
				"command": "frontierThemes.pickTheme",
				"title": "Frontier Themes: Pick Theme",
				"icon": "$(symbol-color)"
			},
			{
				"command": "frontierThemes.pickThemeByCategory",
				"title": "Frontier Themes: Pick by Category"
			},
			{
				"command": "frontierThemes.toggleAurora",
				"title": "Frontier Themes: Toggle Aurora Background",
				"icon": "$(sparkle)"
			},
			{
				"command": "frontierThemes.enableAurora",
				"title": "Frontier Themes: Enable Aurora Background"
			},
			{
				"command": "frontierThemes.disableAurora",
				"title": "Frontier Themes: Disable Aurora Background"
			},
			{
				"command": "frontierThemes.installAuroraHelper",
				"title": "Frontier Themes: Install Aurora Helper Extension"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "frontierThemes.pickTheme"
				},
				{
					"command": "frontierThemes.pickThemeByCategory"
				},
				{
					"command": "frontierThemes.toggleAurora"
				},
				{
					"command": "frontierThemes.installAuroraHelper"
				}
			]
		},
		"configuration": {
			"title": "Frontier Themes",
			"properties": {
				"frontierThemes.aurora.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Enable brand-matched animated aurora background (requires a CSS/JS injection helper extension)."
				},
				"frontierThemes.showStatusBarPicker": {
					"type": "boolean",
					"default": true,
					"description": "Show the theme picker and aurora toggle in the status bar."
				}
			}
		}
	},
	"scripts": {
		"generate": "node scripts/generate-themes.mjs && node scripts/generate-aurora.mjs",
		"package": "vsce package",
		"publish": "vsce publish"
	},
	"devDependencies": {
		"@vscode/vsce": "^3.2.1"
	}
