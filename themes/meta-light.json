  "tokenColors": [
    {
      "settings": {
        "foreground": "#050505"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "header",
      "settings": {
        "foreground": "#075c78"
      }
    },
    {
      "scope": [
        "comment",
