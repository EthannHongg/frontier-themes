        "constant",
        "support.constant",
        "variable.arguments"
      ],
      "settings": {
        "foreground": "#b41ab1"
      }
    },
    {
      "scope": "constant.rgb-value",
      "settings": {
        "foreground": "#050505"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#b41ab1"
      }
    },
    {
