  "tokenColors": [
    {
      "settings": {
        "foreground": "#1A1A2E"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "header",
      "settings": {
        "foreground": "#076778"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a7a86",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "variable.arguments"
      ],
      "settings": {
        "foreground": "#972f9f"
      }
    },
    {
      "scope": "constant.rgb-value",
      "settings": {
        "foreground": "#1A1A2E"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#972f9f"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#57790e"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp.character-class"
      ],
      "settings": {
        "foreground": "#af7c03"
      }
    },
    {
