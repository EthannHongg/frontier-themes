  "tokenColors": [
    {
      "settings": {
        "foreground": "#0D0D0D"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "header",
      "settings": {
        "foreground": "#3377f2"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#767676",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "variable.arguments"
      ],
      "settings": {
        "foreground": "#5e62f1"
      }
    },
    {
      "scope": "constant.rgb-value",
      "settings": {
        "foreground": "#0D0D0D"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#d47d05"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#0f9a78"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp.character-class"
      ],
      "settings": {
        "foreground": "#6a7fae"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.escape"
      ],
      "settings": {
        "foreground": "#d32424"
      }
    },
    {
      "scope": "string.quasi",
      "settings": {
        "foreground": "#14857f"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#10A37F"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#429861"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#10A37F"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#14857f"
      }
    },
    {
      "scope": "keyword.operator.new",
      "settings": {
        "foreground": "#429861"
      }
    },
    {
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "#0f9a78"
      }
