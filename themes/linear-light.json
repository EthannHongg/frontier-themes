  "tokenColors": [
    {
      "settings": {
        "foreground": "#121214"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "header",
      "settings": {
        "foreground": "#829af8"
      }
    },
    {
      "scope": [
        "comment",
