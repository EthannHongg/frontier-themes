        "constant",
        "support.constant",
        "variable.arguments"
      ],
      "settings": {
        "foreground": "#a783f7"
      }
    },
    {
      "scope": "constant.rgb-value",
      "settings": {
        "foreground": "#121214"
      }
    },
    {
