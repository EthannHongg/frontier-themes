        "constant",
        "support.constant",
        "variable.arguments"
      ],
      "settings": {
        "foreground": "#ea6fb0"
      }
    },
    {
      "scope": "constant.rgb-value",
      "settings": {
        "foreground": "#F0F0F0"
      }
    },
    {
      "scope": [
        "constant.numeric",
